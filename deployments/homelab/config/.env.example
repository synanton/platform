# Platform homelab deployment — copy to config/.env (gitignored; never commit).
# All values are environment defaults — generate fresh secrets for each site.

# ── JWT signing key (shared by synflux and synquest; HS256, >= 32 bytes) ──
# Generate: openssl rand -base64 48
SYNANTON_JWT_SECRET=replace-me-with-at-least-32-bytes-of-random

# ── local-registry basic auth (image mirror + kubelet pulls) ──
# The registry on node0 requires basic auth; these also feed
# scripts/create-registry-secret.sh (the per-namespace pull secret).
REGISTRY_USER=
REGISTRY_PASSWORD=

# ── Registry host (default; /etc/hosts maps local-registry -> 192.168.10.30) ──
REGISTRY=local-registry:5000

# ── Postgres (extraction gateway + Syntology store) ──
POSTGRES_PASSWORD=changeme

# ── Neo4j (Relix graph store) ──
NEO4J_PASSWORD=changeme-neo4j

# ── MinIO (object store + extraction handoff) ──
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin

# ── Demo login (security-htpasswd; bcrypt-hashed by deploy-demo.sh) ──
DEMO_USER=demo
DEMO_PASSWORD=change-me-before-deploying

# ── NFS fixture mount on the operator machine (run-slice.sh) ──
# run-slice.sh writes the per-run fixture root under this mount; the pods see
# it at /fixtures. Default matches the as-built workstation mount.
FIXTURE_NFS_MOUNT=/mnt/wd6000
FIXTURE_NFS_SUBDIR=synanton-slice
