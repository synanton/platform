# Local model path (homelab: mounted on node1/node2/node3).
# Outside the homelab, use the Hub id: EMBED_MODEL=BAAI/bge-small-en-v1.5
# and set MODEL_LOCAL_FILES_ONLY=false.
EMBED_MODEL=/mnt/local-fast/models/bge-small-en-v1.5
EMBED_MODEL_NAME=BAAI/bge-small-en-v1.5

# bge-small-en-v1.5 is 384d. The startup probe measures this; a mismatch fails.
EMBED_DIM=384

# The deployment chooses the device. Homelab GPU nodes: cuda. CPU: cpu.
EMBED_DEVICE=cuda
MODEL_LOCAL_FILES_ONLY=true
MAX_BATCH_SIZE=100
EMBEDDING_PORT=8000

# The service never truncates. Non-zero is logged and ignored.
EMBED_TRUNCATE_DIM=0
