# Copy to .env before running `./scripts/run-demo.sh`.
# All values are demo defaults - do NOT reuse in any non-demo environment.

# ───── Postgres ─────
POSTGRES_USER=synanton
POSTGRES_PASSWORD=changeme
POSTGRES_DB=synanton

# ───── JWT signing key (shared by security, topology, syntology) ─────
# Must be at least 32 bytes for HS256.
SYNANTON_JWT_SECRET=replace-me-with-at-least-32-bytes-of-random

# ───── Service ports (host-exposed) ─────
SYNTOLOGY_ADMIN_PORT=8080
