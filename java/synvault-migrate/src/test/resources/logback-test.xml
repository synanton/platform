<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder><pattern>%level %logger{20} - %msg%n</pattern></encoder>
    </appender>
    <logger name="org.synanton.ingestioncache" level="DEBUG"/>
    <root level="WARN"><appender-ref ref="STDOUT"/></root>
</configuration>
