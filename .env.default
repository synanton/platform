# Default environment for the Benchmark Runner (BR-A0.1, decision 1b)
#
# Committed defaults with placeholder values. Copy to `.env` (git-ignored)
# and fill in real secrets locally — never commit `.env`.
# Variable names are PROPOSED here and normed at BR-A0.2 schema freeze;
# manifests reference these names via ${VAR} interpolation.
#
# See also: .env.example (platform-wide vars), benchmark-runner-requirements.md §1.

# ───── Embedding endpoint (query + ingest embedding) ─────
# Base URL of the OpenAI-compatible embeddings endpoint used by synflux/synquest.
EMBED_BASE_URL=http://localhost:8081/v1
# API key for the embedding endpoint. Empty means unauthenticated (dev default).
EMBED_API_KEY=

# ───── Milvus (compositions 2, 4) ─────
# gRPC URI of the Milvus instance under benchmark.
BENCH_MILVUS_URI=http://localhost:19530
# API token; empty for open local deployments.
BENCH_MILVUS_TOKEN=

# ───── Qdrant (compositions 3, 5) ─────
# HTTP(S) URL of the Qdrant instance under benchmark.
BENCH_QDRANT_URL=http://localhost:6333
# API key; empty for open local deployments.
BENCH_QDRANT_API_KEY=

# ───── PostgreSQL (compositions 4, 5) ─────
# JDBC URL of the Postgres under benchmark (must have pgvector).
BENCH_PG_URL=jdbc:postgresql://localhost:5432/synanton
BENCH_PG_USER=synanton
BENCH_PG_PASSWORD=changeme

# ───── Runner cost controls (BR-A0.1 §7) ─────
# Hard timeout per composition run (ms). Runner aborts loudly past it.
BENCH_TIMEOUT_MS=3600000
# Maximum events per run. Guard fires loudly past it.
BENCH_MAX_EVENT_COUNT=1000000
